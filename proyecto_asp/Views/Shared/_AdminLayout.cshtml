@{
    bool isEmpleadoMode = (User.IsInRole("Empleado") && !User.IsInRole("Admin"))
                          || ViewContext.RouteData.Values["Controller"]?.ToString() == "Empleado"
                          || ViewBag.IsEmpleadoMode == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pamelita</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#ff6600" />
</head>
<body style="background-color: #f8f9fa;">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-pamelita">
            <div class="container-fluid px-3 px-md-4">
                @if (isEmpleadoMode)
                {
                    <a class="navbar-brand navbar-brand-pamelita me-lg-4" asp-controller="Empleado" asp-action="Index">
                        <span class="brand-icon">🥟</span> Pamelita
                    </a>
                }
                else
                {
                    <a class="navbar-brand navbar-brand-pamelita me-lg-4" asp-controller="Admin" asp-action="Dashboard">
                        <span class="brand-icon">🥟</span> Pamelita
                    </a>
                }
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarAdminContent"
                        aria-controls="navbarAdminContent" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarAdminContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center gap-2">
                        @if (isEmpleadoMode)
                        {
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm text-dark fw-bold rounded-pill shadow-sm px-3 active" asp-controller="Empleado" asp-action="Index">
                                    <i class="bi bi-cash-coin me-1"></i> POS Pedidos
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-pamelita @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                </a>
                            </li>

                            @* Submenú Inventario *@
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-pamelita dropdown-toggle @(new[] { "Productos", "Categorias" }.Contains(ViewContext.RouteData.Values["Action"]?.ToString()) || ViewContext.RouteData.Values["Controller"]?.ToString() == "Insumos" ? "active" : "")"
                                   href="#" id="inventarioDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-boxes me-1"></i> Inventario
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="inventarioDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Productos">
                                            <i class="bi bi-box-seam me-2 text-primary"></i> Productos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Insumos" asp-action="Index">
                                            <i class="bi bi-archive me-2 text-warning"></i> Insumos
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Categorias">
                                            <i class="bi bi-tags me-2 text-info"></i> Categorías
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            @* Submenú Clientes *@
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-pamelita dropdown-toggle @(new[] { "HistorialCompras", "ComentariosClientes", "Contacto" }.Contains(ViewContext.RouteData.Values["Action"]?.ToString()) ? "active" : "")"
                                   href="#" id="clientesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-people me-1"></i> Clientes
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="clientesDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="HistorialCompras">
                                            <i class="bi bi-receipt me-2 text-success"></i> Historial de Pedidos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="ComentariosClientes">
                                            <i class="bi bi-star-half me-2 text-warning"></i> Comentarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Admin" asp-action="Contacto">
                                            <i class="bi bi-envelope me-2 text-primary"></i> Contacto
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-link-pamelita @(ViewContext.RouteData.Values["Action"]?.ToString() == "Proveedores" ? "active" : "")" asp-controller="Admin" asp-action="Proveedores">
                                    <i class="bi bi-truck me-1"></i> Proveedores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-pamelita @(ViewContext.RouteData.Values["Action"]?.ToString()?.StartsWith("Empleado") == true ? "active" : "")" asp-controller="Admin" asp-action="Empleados">
                                    <i class="bi bi-person-badge me-1"></i> Empleados
                                </a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="btn btn-warning btn-sm text-dark fw-bold rounded-pill shadow-sm px-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "PosPedidos" ? "active" : "")" asp-controller="Admin" asp-action="PosPedidos">
                                    <i class="bi bi-cash-coin me-1"></i> POS Pedidos
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav align-items-center gap-2 ms-auto flex-row flex-shrink-0 pe-2">
                        <li class="nav-item">
                            @if (isEmpleadoMode)
                            {
                                <a asp-controller="Empleado" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill fw-bold" style="min-width:120px;">
                                    <i class="bi bi-person-badge me-1"></i> Modo Empleado
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill fw-bold" style="min-width:120px;">
                                    <i class="bi bi-shop me-1"></i> Modo Cliente
                                </a>
                            }
                        </li>
                        <li class="nav-item">
                            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-pamelita-secondary btn-sm" style="min-width:100px;">
                                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Script universal de búsqueda en paneles administrativos
        $(document).ready(function () {
            $(document).on("input keyup change", ".admin-search-input", function () {
                var value = $(this).val().toLowerCase();
                var target = $(this).data("target");
                
                $(target).filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });

        // Registro de Service Worker para PWA en modo Admin
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('SW Admin registrado con éxito:', reg))
                    .catch(err => console.log('Error registrando SW Admin:', err));
            });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>