@model IEnumerable<proyecto_asp.Models.Product>

@{
    string catNombre = ViewBag.CategoriaNombre as string ?? "Categoría";
    string catIcono = ViewBag.CategoriaIcono as string ?? "bi-tag";
    ViewData["Title"] = catNombre + " - Empanadas Pamelita";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 bg-white p-4 rounded-3 shadow-sm border border-warning">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi @catIcono text-warning me-2"></i>@catNombre
            </h2>
            <p class="text-muted small mb-0">Explora todos los productos disponibles en la categoría <strong>@catNombre</strong></p>
        </div>

        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Todo el Menú
            </a>
        </div>
    </div>

    @* Buscador en su propia línea completa debajo del título *@
    <div class="mb-4">
        <form method="get" asp-action="Categoria" class="w-100">
            <input type="hidden" name="nombre" value="@catNombre" />
            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-warning"></i></span>
                <input type="text" name="searchQuery" id="buscadorCategoria" value="@ViewBag.SearchQuery" class="form-control border-start-0 ps-0" placeholder="Buscar productos en @catNombre..." />
                <button type="button" class="btn-voice" data-voice-for="buscadorCategoria" title="Buscar por voz">
                    <i class="bi bi-mic-fill"></i>
                </button>
                <button type="submit" class="btn btn-warning fw-bold px-4">Buscar</button>
            </div>
        </form>
    </div>

    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            foreach (var product in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="product-card">
                        <div class="product-img-wrapper">
                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=600" : product.ImageUrl)"
                                 class="product-img"
                                 alt="@product.Name"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=600';" />

                            <span class="category-badge">
                                @(string.IsNullOrEmpty(product.Category) ? "Empanada" : product.Category)
                            </span>

                            <span class="price-pill">
                                Bs. @product.Price.ToString("F2")
                            </span>
                        </div>

                        <div class="product-card-body">
                            <h3 class="product-title">@product.Name</h3>
                            <p class="product-desc">@product.Description</p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stock-indicator">
                                    <i class="bi bi-box-seam"></i> Stock: @product.Stock unids
                                </span>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1 add-to-cart-form">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-pamelita-primary w-100">
                                        <i class="bi bi-cart-plus me-1"></i> Añadir
                                    </button>
                                </form>
                                <a href="@Url.Action("Details", new { id = product.Id })" class="btn btn-pamelita-secondary text-center" title="Ver Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                {
                                    <a href="@Url.Action("Edit", new { id = product.Id })" class="btn btn-pamelita-warning btn-sm d-flex align-items-center" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="p-5 bg-white rounded-3 border border-secondary shadow-sm">
                    <i class="bi bi-box-seam display-3 text-muted mb-3 d-block"></i>
                    <h4 class="text-muted">No se encontraron productos en "@catNombre"</h4>
                    <p class="text-muted small mb-3">Prueba buscando con otro término o explora las demás categorías.</p>
                    <a asp-action="Index" class="btn btn-warning">
                        <i class="bi bi-shop me-1"></i> Ver Todo el Menú
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.add-to-cart-form').submit(function (e) {
                e.preventDefault();
                var form = $(this);
                var btn = form.find('button[type="submit"]');
                var originalHtml = btn.html();

                btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>').prop('disabled', true);

                $.ajax({
                    type: 'POST',
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (response) {
                        if (response.success && response.count > 0) {
                            var badge = $('#cart-count');
                            badge.text(response.count);
                            if (badge.css('display') === 'none') {
                                badge.show();
                            }
                            badge.addClass('animate__animated animate__bounceIn');
                            setTimeout(function(){ badge.removeClass('animate__animated animate__bounceIn'); }, 1000);
                        }

                        btn.removeClass('btn-pamelita-primary').addClass('btn-success').html('<i class="bi bi-check-lg"></i> Listo');
                        setTimeout(function() {
                            btn.removeClass('btn-success').addClass('btn-pamelita-primary').html(originalHtml).prop('disabled', false);
                        }, 1500);
                    },
                    error: function () {
                        btn.html(originalHtml).prop('disabled', false);
                        alert("Hubo un error al añadir al carrito.");
                    }
                });
            });
        });
    </script>
}