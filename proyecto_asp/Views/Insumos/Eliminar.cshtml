@model proyecto_asp.Models.Insumo

@{
    ViewData["Title"] = "Eliminar Insumo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0 border-top border-4 border-danger">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h3 class="fw-bold text-danger">
                    <i class="bi bi-trash me-2"></i>Eliminar Insumo
                </h3>
                <p class="text-muted small">Esta acción no se puede deshacer. ¿Estás seguro?</p>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="bg-light rounded p-3 mb-4">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal">Nombre</th>
                                <td class="fw-bold">@Model.Nombre</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Descripción</th>
                                <td>@(Model.Descripcion ?? "—")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Unidad</th>
                                <td><span class="badge bg-secondary">@Model.Unidad</span></td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Stock Actual</th>
                                <td class="fw-bold @(Model.TieneStockBajo ? "text-danger" : "")">
                                    @Model.StockActual.ToString("F2") @Model.Unidad
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Costo Unitario</th>
                                <td>Bs. @Model.CostoUnitario.ToString("F2")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Creado el</th>
                                <td class="small text-muted">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <form asp-action="Eliminar" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Sí, Eliminar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
