@model IEnumerable<proyecto_asp.Models.Contacto>

@{
    ViewData["Title"] = "Mensajes de Contacto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-envelope text-primary"></i> Mensajes de Contacto
    </h2>
    <span class="badge bg-secondary fs-6">@Model.Count() mensaje(s)</span>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-envelope-open display-3 text-muted d-block mb-3"></i>
        <h5 class="text-muted">No hay mensajes de contacto aún.</h5>
    </div>
}
else
{
    <div class="input-group mb-4">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input type="text" class="form-control admin-search-input" data-target=".searchable-item" placeholder="Buscar por nombre, correo, mensaje, fecha...">
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var c in Model)
        {
            string inicial = c.Nombre.Substring(0, 1).ToUpper();

            <div class="card border-0 shadow-sm searchable-item @(c.Leido ? "" : "border-start border-4 border-primary")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center fw-bold text-white"
                             style="width:42px;height:42px;font-size:1.1rem;flex-shrink:0;">
                            @inicial
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                <div>
                                    <span class="fw-bold">@c.Nombre</span>
                                    @if (!c.Leido)
                                    {
                                        <span class="badge bg-primary ms-2 small">Nuevo</span>
                                    }
                                    <br />
                                    <small class="text-muted">
                                        <i class="bi bi-envelope me-1"></i>@c.Email
                                    </small>
                                </div>
                                <small class="text-muted">@c.FechaEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                    </div>
                    <div class="ms-5 ps-2 mt-1 p-3 bg-light rounded">
                        <p class="mb-0 text-secondary">@c.Mensaje</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
