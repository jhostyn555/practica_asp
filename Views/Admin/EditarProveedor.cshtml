@model proyecto_asp.Models.Proveedor

@{
    ViewData["Title"] = "Editar Proveedor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h3 class="fw-bold">
                    <i class="bi bi-pencil-square text-warning me-2"></i>Editar Proveedor
                </h3>
                <p class="text-muted small">Modificando los datos de <strong>@Model.Nombre</strong>.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="EditarProveedor">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre del Proveedor</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Contacto" class="form-label fw-semibold">Persona de Contacto</label>
                            <input asp-for="Contacto" class="form-control" />
                            <span asp-validation-for="Contacto" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefono" class="form-label fw-semibold">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Direccion" class="form-label fw-semibold">Dirección</label>
                        <input asp-for="Direccion" class="form-control" />
                        <span asp-validation-for="Direccion" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-white">
                            <i class="bi bi-floppy me-1"></i> Guardar Cambios
                        </button>
                        <a asp-action="Proveedores" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
