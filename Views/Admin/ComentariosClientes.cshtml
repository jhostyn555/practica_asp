@model IEnumerable<proyecto_asp.Models.Opinion>

@{
    ViewData["Title"] = "Comentarios de Clientes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-star-half text-warning"></i> Comentarios de Clientes
    </h2>
    <span class="badge bg-secondary fs-6">@Model.Count() comentario(s)</span>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-chat-square-text display-3 text-muted d-block mb-3"></i>
        <h5 class="text-muted">Aún no hay comentarios de clientes.</h5>
    </div>
}
else
{
    <div class="input-group mb-4">
        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
        <input type="text" id="comentariosSearch" class="form-control admin-search-input" data-target=".searchable-item" placeholder="Buscar por nombre, comentario, fecha...">
        <button type="button" class="btn-voice" data-voice-for="comentariosSearch" title="Buscar por voz">
            <i class="bi bi-mic-fill"></i>
        </button>
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var op in Model)
        {
            string nombre = op.NombrePublico ?? op.User?.FullName ?? op.User?.Email ?? "Anónimo";
            string inicial = nombre.Substring(0, 1).ToUpper();

            <div class="card border-0 shadow-sm searchable-item">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center fw-bold text-dark"
                             style="width:42px;height:42px;font-size:1.1rem;flex-shrink:0;">
                            @inicial
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                <span class="fw-bold">@nombre</span>
                                <small class="text-muted">@op.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="text-warning mt-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= op.Calificacion)
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                }
                                <span class="text-muted small ms-1">(@op.Calificacion / 5)</span>
                            </div>
                        </div>
                    </div>
                    <p class="mb-0 ms-5 ps-2 text-secondary">@(op.Comentario ?? "—")</p>
                </div>
            </div>
        }
    </div>
}
