@model proyecto_asp.Models.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0 border-top border-4 border-danger">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-triangle-fill text-danger display-4 mb-3"></i>
                <h4 class="fw-bold">¿Eliminar este empleado?</h4>
                <p class="text-muted mb-4">
                    Estás a punto de eliminar a <strong>"@Model.Nombre"</strong> de la lista de empleados.
                </p>

                <div class="card bg-light border-0 mb-4 text-start">
                    <div class="card-body">
                        <p class="mb-1"><strong>Nombre:</strong> @Model.Nombre</p>
                        <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
                        <p class="mb-1"><strong>Cargo:</strong> @Model.Cargo</p>
                        <p class="mb-0"><strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")</p>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="Empleados" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>
                    <form asp-action="EliminarEmpleado" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Sí, eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
