@model proyecto_asp.Models.Empleado

@{
    ViewData["Title"] = "Nuevo Empleado";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Empleado</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CrearEmpleado" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Carlos Mamani" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="carlos@pamelita.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Password" class="form-control" type="password" id="empPassword" placeholder="••••••••" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleEmpPass">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-bold"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="71234567" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cargo" class="form-label fw-bold"></label>
                            <input asp-for="Cargo" class="form-control" placeholder="Cajero / Atención" />
                            <span asp-validation-for="Cargo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Activo" id="activoCheck" checked />
                            <label class="form-check-label fw-bold" for="activoCheck">Empleado activo</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Empleados" class="btn btn-outline-secondary flex-grow-1 text-center">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-check-circle me-1"></i> Guardar Empleado
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleEmpPass')?.addEventListener('click', function () {
            const input = document.getElementById('empPassword');
            const icon = this.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
}
