@model proyecto_asp.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0 border-top border-4 border-danger">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h3 class="fw-bold text-danger">
                    <i class="bi bi-trash me-2"></i>Eliminar Proveedor
                </h3>
                <p class="text-muted small">Esta acción no se puede deshacer. ¿Estás seguro?</p>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="bg-light rounded p-3 mb-4">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted fw-normal" style="width:40%"># ID</th>
                                <td class="fw-bold">@Model.Id</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Nombre</th>
                                <td class="fw-bold">@Model.Nombre</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Contacto</th>
                                <td>@(Model.Contacto ?? "—")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Teléfono</th>
                                <td>@(Model.Telefono ?? "—")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Dirección</th>
                                <td>@(Model.Direccion ?? "—")</td>
                            </tr>
                            <tr>
                                <th class="text-muted fw-normal">Registrado</th>
                                <td class="small text-muted">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <form asp-action="EliminarProveedor" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Sí, Eliminar
                        </button>
                        <a asp-action="Proveedores" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
