@model List<proyecto_asp.Models.CartItem>

@{
    ViewData["Title"] = "Carrito de Compras";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 text-warning"></i> Tu Carrito</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Precio</th>
                                        <th>Cantidad</th>
                                        <th>Subtotal</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=100" : item.ImageUrl)" alt="@item.ProductName" class="img-thumbnail me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                                    <span class="fw-bold">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td>Bs. @item.Price.ToString("F2")</td>
                                            <td style="width: 150px;">
                                                <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" step="1" 
                                                           class="form-control form-control-sm text-center" style="width: 70px;" 
                                                           onchange="this.form.submit()" onkeypress="return event.charCode >= 48 && event.charCode <= 57" />
                                                </form>
                                            </td>
                                            <td class="fw-bold">Bs. @item.Total.ToString("F2")</td>
                                            <td>
                                                <form asp-action="Remove" method="post">
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3">Resumen del Pedido</h4>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <span>Bs. @Model.Sum(i => i.Total).ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong class="fs-5">Total</strong>
                            <strong class="fs-5 text-warning">Bs. @Model.Sum(i => i.Total).ToString("F2")</strong>
                        </div>
                        <a asp-action="Checkout" class="btn btn-pamelita-primary w-100 btn-lg">Continuar con el Pago</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted mb-3"></i>
            <h3>Tu carrito está vacío</h3>
            <p class="text-muted">Parece que aún no has añadido ninguna deliciosa empanada.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-pamelita-primary mt-3">Ir al Menú</a>
        </div>
    }
</div>
