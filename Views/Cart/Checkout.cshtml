@model List<proyecto_asp.Models.CartItem>

@{
    ViewData["Title"] = "Confirmar Pedido";
}

<div class="container my-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-credit-card-2-front text-warning"></i> Confirmar Pedido</h2>

    <div class="row">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4 p-4">
                <h4 class="mb-4">Método de Pago</h4>
                <form asp-action="ProcessCheckout" method="post">
                    <div class="mb-4">
                        <div class="form-check mb-3 p-3 border rounded shadow-sm">
                            <input class="form-check-input ms-1" type="radio" name="metodoPago" id="pagoEfectivo" value="Efectivo" checked>
                            <label class="form-check-label ms-2 fw-bold d-flex align-items-center" for="pagoEfectivo">
                                <i class="bi bi-cash-stack text-success fs-4 me-2"></i> Pago en Efectivo
                            </label>
                            <small class="text-muted d-block ms-5">Pagos al momento de recibir o retirar el pedido.</small>
                        </div>
                        
                        <div class="form-check mb-3 p-3 border rounded shadow-sm">
                            <input class="form-check-input ms-1" type="radio" name="metodoPago" id="pagoQR" value="QR">
                            <label class="form-check-label ms-2 fw-bold d-flex align-items-center" for="pagoQR">
                                <i class="bi bi-qr-code-scan text-primary fs-4 me-2"></i> Pago con QR Simple
                            </label>
                            <small class="text-muted d-block ms-5">Transferencia rápida mediante código QR.</small>
                        </div>
                        
                        <div class="form-check p-3 border rounded shadow-sm">
                            <input class="form-check-input ms-1" type="radio" name="metodoPago" id="pagoTarjeta" value="Tarjeta">
                            <label class="form-check-label ms-2 fw-bold d-flex align-items-center" for="pagoTarjeta">
                                <i class="bi bi-credit-card text-info fs-4 me-2"></i> Tarjeta de Crédito/Débito
                            </label>
                            <small class="text-muted d-block ms-5">Pago seguro mediante tarjeta.</small>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-pamelita-primary btn-lg w-100">Confirmar Pedido</button>
                </form>
            </div>
        </div>
        
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Resumen de tu compra</h5>
                    <ul class="list-group list-group-flush mb-3">
                        @foreach(var item in Model)
                        {
                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <h6 class="my-0">@item.ProductName</h6>
                                    <small class="text-muted">Cant: @item.Quantity</small>
                                </div>
                                <span class="text-muted">Bs. @item.Total.ToString("F2")</span>
                            </li>
                        }
                    </ul>
                    <hr>
                    <div class="d-flex justify-content-between mt-3">
                        <strong class="fs-5">Total a Pagar</strong>
                        <strong class="fs-5 text-warning">Bs. @Model.Sum(i => i.Total).ToString("F2")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
