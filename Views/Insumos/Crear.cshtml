@model proyecto_asp.Models.Insumo

@{
    ViewData["Title"] = "Nuevo Insumo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h3 class="fw-bold">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Nuevo Insumo
                </h3>
                <p class="text-muted small">Completa los datos del nuevo material o materia prima.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Crear">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Harina de trigo" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"
                                  placeholder="Descripción opcional del insumo..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Unidad" class="form-label fw-semibold"></label>
                        <select asp-for="Unidad" class="form-select">
                            <option value="">-- Seleccionar unidad --</option>
                            <option value="kg">Kilogramos (kg)</option>
                            <option value="g">Gramos (g)</option>
                            <option value="litros">Litros</option>
                            <option value="ml">Mililitros (ml)</option>
                            <option value="unidades">Unidades</option>
                            <option value="cajas">Cajas</option>
                            <option value="bolsas">Bolsas</option>
                            <option value="paquetes">Paquetes</option>
                        </select>
                        <span asp-validation-for="Unidad" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockActual" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="StockActual" class="form-control" placeholder="0.00" />
                                <span class="input-group-text text-muted" id="unidad-display">—</span>
                            </div>
                            <span asp-validation-for="StockActual" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockMinimo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="StockMinimo" class="form-control" placeholder="5.00" />
                                <span class="input-group-text text-muted">mín.</span>
                            </div>
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CostoUnitario" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">Bs.</span>
                            <input asp-for="CostoUnitario" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1"></i> Guardar Insumo
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Mostrar la unidad seleccionada en los inputs de stock
        const selectUnidad = document.querySelector('select[name="Unidad"]');
        const unidadDisplay = document.getElementById('unidad-display');
        selectUnidad.addEventListener('change', function () {
            unidadDisplay.textContent = this.value || '—';
        });
    </script>
}
