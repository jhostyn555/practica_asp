@model proyecto_asp.Models.Insumo

@{
    ViewData["Title"] = "Editar Insumo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h3 class="fw-bold">
                    <i class="bi bi-pencil-square text-warning me-2"></i>Editar Insumo
                </h3>
                <p class="text-muted small">Modifica los datos del insumo <strong>@Model.Nombre</strong>.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Unidad" class="form-label fw-semibold"></label>
                        <select asp-for="Unidad" class="form-select">
                            <option value="">-- Seleccionar unidad --</option>
                            <option value="kg">Kilogramos (kg)</option>
                            <option value="g">Gramos (g)</option>
                            <option value="litros">Litros</option>
                            <option value="ml">Mililitros (ml)</option>
                            <option value="unidades">Unidades</option>
                            <option value="cajas">Cajas</option>
                            <option value="bolsas">Bolsas</option>
                            <option value="paquetes">Paquetes</option>
                        </select>
                        <span asp-validation-for="Unidad" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockActual" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="StockActual" class="form-control" />
                                <span class="input-group-text text-muted">@Model.Unidad</span>
                            </div>
                            <span asp-validation-for="StockActual" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="StockMinimo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="StockMinimo" class="form-control" />
                                <span class="input-group-text text-muted">mín.</span>
                            </div>
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CostoUnitario" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">Bs.</span>
                            <input asp-for="CostoUnitario" class="form-control" />
                        </div>
                        <span asp-validation-for="CostoUnitario" class="text-danger small"></span>
                    </div>

                    @if (Model.TieneStockBajo)
                    {
                        <div class="alert alert-warning small mb-4">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Este insumo tiene stock por debajo del mínimo establecido.
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-white">
                            <i class="bi bi-floppy me-1"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
