@model IEnumerable<proyecto_asp.Models.Insumo>

@{
    ViewData["Title"] = "Inventario de Insumos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-boxes text-primary"></i> Inventario de Insumos
    </h2>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Nuevo Insumo
    </a>
</div>

@{
    var conStockBajo = Model.Count(i => i.TieneStockBajo);
}

@if (conStockBajo > 0)
{
    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>
            <strong>Atención:</strong> Hay <strong>@conStockBajo</strong> insumo(s) con stock por debajo del mínimo.
        </div>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input type="text" id="insumosSearch" class="form-control admin-search-input" data-target=".searchable-item" placeholder="Buscar por nombre, descripción o unidad...">
            <button type="button" class="btn-voice" data-voice-for="insumosSearch" title="Buscar por voz">
                <i class="bi bi-mic-fill"></i>
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Descripción</th>
                            <th>Unidad</th>
                            <th class="text-center">Stock Actual</th>
                            <th class="text-center">Stock Mínimo</th>
                            <th class="text-end">Costo Unitario</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="searchable-item @(item.TieneStockBajo ? "table-warning" : "")">
                                <td class="ps-4 fw-semibold">@item.Nombre</td>
                                <td class="text-muted small">@(item.Descripcion ?? "—")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.Unidad</span>
                                </td>
                                <td class="text-center fw-bold @(item.TieneStockBajo ? "text-danger" : "text-success")">
                                    @item.StockActual.ToString("F2")
                                </td>
                                <td class="text-center text-muted">@item.StockMinimo.ToString("F2")</td>
                                <td class="text-end">Bs. @item.CostoUnitario.ToString("F2")</td>
                                <td class="text-center">
                                    @if (item.TieneStockBajo)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Stock Bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>OK
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Editar" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Eliminar" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-box-seam display-3 text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No hay insumos registrados</h5>
                <p class="text-muted">Agrega el primer insumo para comenzar a gestionar el inventario.</p>
                <a asp-action="Crear" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Agregar Insumo
                </a>
            </div>
        }
    </div>
</div>
