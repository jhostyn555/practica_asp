@model proyecto_asp.Models.Contacto

@{
    ViewData["Title"] = "Contacto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-envelope-paper display-4 text-warning"></i>
                        <h2 class="fw-bold mt-2">Contáctanos</h2>
                        <p class="text-muted">Déjanos tu mensaje y te responderemos lo más pronto posible.</p>
                    </div>

                    @if (TempData["MensajeExito"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i> @TempData["MensajeExito"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Enviar" method="post">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre Completo</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Mensaje" class="form-label fw-bold">Mensaje</label>
                            <textarea asp-for="Mensaje" class="form-control" rows="5" placeholder="Escribe tu mensaje o pedido aquí..."></textarea>
                            <span asp-validation-for="Mensaje" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold">
                                <i class="bi bi-send me-2"></i> Enviar Mensaje
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
