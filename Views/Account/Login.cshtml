@model proyecto_asp.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión - Empanadas Pamelita";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card-pamelita-form text-center">
                <div class="mb-3">
                    <span class="display-3">🥟</span>
                </div>
                <h2 class="fw-extrabold text-dark mb-1">Empanadas Pamelita</h2>
                <p class="text-muted small mb-4">Ingresa a tu cuenta para realizar tus pedidos</p>

                <form asp-action="Login" method="post" class="text-start">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control form-control-pamelita" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Contraseña</label>
                        <input asp-for="Password" class="form-control form-control-pamelita" type="password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-group form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-secondary fw-medium">Recordarme</label>
                    </div>

                    <button type="submit" class="btn btn-pamelita-primary w-100 mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </button>

                    <div class="text-center pt-2 border-top">
                        <span class="text-muted small">¿No tienes cuenta?</span>
                        <a href="@Url.Action("Register")" class="text-warning fw-bold text-decoration-none ms-1">Regístrate aquí</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
