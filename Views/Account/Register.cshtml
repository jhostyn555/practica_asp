@model proyecto_asp.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registro - Empanadas Pamelita";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card-pamelita-form">
                <div class="text-center mb-4">
                    <span class="display-3">🥐</span>
                    <h2 class="fw-extrabold text-dark mb-1">Crea tu Cuenta</h2>
                    <p class="text-muted small">Únete a la familia de Empanadas Pamelita</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label fw-bold">Nombre Completo</label>
                        <input asp-for="FullName" class="form-control form-control-pamelita" placeholder="Nombre y Apellido" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control form-control-pamelita" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold">Contraseña</label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control form-control-pamelita border-end-0" type="password" placeholder="••••••••" id="passwordInput" />
                                <button class="btn border border-start-0 bg-white text-secondary toggle-password" type="button" data-target="passwordInput">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirmar Contraseña</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" class="form-control form-control-pamelita border-end-0" type="password" placeholder="••••••••" id="confirmPasswordInput" />
                                <button class="btn border border-start-0 bg-white text-secondary toggle-password" type="button" data-target="confirmPasswordInput">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Address" class="form-label fw-bold">Dirección de Entrega</label>
                        <input asp-for="Address" class="form-control form-control-pamelita" placeholder="Calle / Av. y Número" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-pamelita-primary w-100 mb-3">
                        <i class="bi bi-person-check me-1"></i> Registrarse Ahora
                    </button>
                </form>

                <!-- Separador visual -->
                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="px-2 text-muted small fw-bold">O</span>
                    <hr class="flex-grow-1" />
                </div>

                <!-- Formulario e inicio de sesión con Google -->
                <form asp-controller="Account" asp-action="ExternalLogin" method="post" class="mb-3">
                    <input type="hidden" name="provider" value="Google" />
                    <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 fw-bold py-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                            <path d="M15.545 6.558a9.42 9.42 0 0 0 .139-1.626c0-.72-.07-1.423-.193-2.092H8v3.974h4.307a3.682 3.682 0 0 1-1.59 2.418v2.008h2.573c1.505-1.388 2.37-3.433 2.37-5.682z" />
                            <path d="M8 16c2.16 0 3.974-.716 5.299-1.942l-2.573-2.008c-.717.48-1.634.766-2.726.766-2.096 0-3.872-1.414-4.508-3.314H.842v2.072A8.001 8.001 0 0 0 8 16z" />
                            <path d="M3.492 9.502a4.803 4.803 0 0 1 0-3.004V4.426H.842a8.002 8.002 0 0 0 0 7.148l2.65-2.072z" />
                            <path d="M8 3.166c1.173 0 2.228.404 3.056 1.196l2.292-2.292C11.97.808 10.156 0 8 0A8.001 8.001 0 0 0 .842 4.426l2.65 2.072C4.128 4.58 5.904 3.166 8 3.166z" />
                        </svg>
                        Registrarse con Google
                    </button>
                </form>

                <div class="text-center pt-2 border-top">
                    <span class="text-muted small">¿Ya tienes cuenta?</span>
                    <a href="@Url.Action("Login")" class="text-warning fw-bold text-decoration-none ms-1">Inicia sesión</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const passwordInput = document.getElementById(targetId);
                const icon = this.querySelector('i');
                
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    passwordInput.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });
    </script>
}
