<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Empanadas Pamelita 🥟</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#ff6600" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-pamelita">
            <div class="container">
                <a class="navbar-brand navbar-brand-pamelita" asp-area="" asp-controller="Products" asp-action="Index">
                    <span class="brand-icon">🥟</span> Empanadas Pamelita
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPamelitaContent"
                        aria-controls="navbarPamelitaContent" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarPamelitaContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-pamelita active" asp-area="" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-shop me-1"></i> Menú
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-pamelita" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoria="Empanadas">
                                Empanadas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-pamelita" asp-area="" asp-controller="Products" asp-action="Index" asp-route-categoria="Refrescos">
                                Refrescos
                            </a>
                        </li>
                    </ul>
                    
                    <form class="d-flex mx-auto w-50 my-2 my-lg-0" asp-controller="Products" asp-action="Index" method="get">
                        <div class="input-group">
                            <input class="form-control" type="search" placeholder="Buscar empanadas, refrescos..." aria-label="Search" name="searchQuery" value="@ViewBag.SearchQuery">
                            <button class="btn btn-warning text-dark fw-bold" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                    
                    <ul class="navbar-nav align-items-center gap-2 ms-auto">
                        <li class="nav-item me-3">
                            <a class="nav-link nav-link-pamelita position-relative" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span id="cart-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; display: none;">
                                    0
                                </span>
                            </a>
                        </li>
                        @using Microsoft.AspNetCore.Identity
                        @using proyecto_asp.Models
                        @inject SignInManager<ApplicationUser> SignInManager

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="user-badge">
                                    <i class="bi bi-person-fill-check"></i> Hola, @User.Identity.Name
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark ms-1 text-decoration-none">Panel Admin</a>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-pamelita-secondary btn-sm">
                                        <i class="bi bi-box-arrow-right me-1"></i> Salir
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-pamelita-secondary btn-sm" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-pamelita-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Registrarse
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <!-- Banner de Instalación PWA -->
        <div id="pwaInstallAlert" class="alert alert-warning alert-dismissible fade show d-none shadow-sm" role="alert">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-phone me-2 fs-5"></i>
                    <strong>¡Instala nuestra App!</strong> Para pedidos más rápidos, instala Empanadas Pamelita en tu dispositivo.
                </div>
                <button type="button" id="installPwaBtn" class="btn btn-warning btn-sm fw-bold">Instalar App</button>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-pamelita">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-3 mb-md-0">
                    <h5 class="fw-bold text-warning mb-1">🥟 Empanadas Pamelita</h5>
                    <p class="small text-white-50 mb-0">Las mejores empanadas artesanales con masa crujiente y relleno jugoso.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="small mb-0">&copy; 2026 - Empanadas Pamelita. Todos los derechos reservados.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Cargar cantidad de carrito
        $(document).ready(function () {
            $.get('@Url.Action("GetCartCount", "Cart")', function (data) {
                if (data.count > 0) {
                    $('#cart-count').text(data.count);
                    $('#cart-count').show();
                } else {
                    $('#cart-count').hide();
                }
            });
        });

        // Registro del Service Worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(registration => {
                        console.log('SW registrado con éxito:', registration);
                    })
                    .catch(error => {
                        console.log('Error registrando el SW:', error);
                    });
            });
        }

        // Lógica para botón de instalación PWA
        let deferredPrompt;
        const installBtn = document.getElementById('installPwaBtn');
        const pwaAlert = document.getElementById('pwaInstallAlert');

        window.addEventListener('beforeinstallprompt', (e) => {
            // Prevenir el mini-infobar por defecto en mobile
            e.preventDefault();
            deferredPrompt = e;
            // Mostrar la alerta o botón
            if (pwaAlert) {
                pwaAlert.classList.remove('d-none');
            }
        });

        if (installBtn) {
            installBtn.addEventListener('click', async () => {
                if (pwaAlert) {
                    pwaAlert.classList.add('d-none');
                }
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log(`PWA installation ${outcome}`);
                    deferredPrompt = null;
                }
            });
        }
        
        window.addEventListener('appinstalled', () => {
            if (pwaAlert) {
                pwaAlert.classList.add('d-none');
            }
            console.log('PWA fue instalada exitosamente.');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
