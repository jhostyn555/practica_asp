@model proyecto_asp.Models.Product

@{
    ViewData["Title"] = "Crear Empanada - Empanadas Pamelita";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card-pamelita-form">
                <div class="d-flex align-items-center mb-4 gap-2">
                    <span class="fs-2">🥐</span>
                    <h2 class="fw-bold m-0 text-dark">Agregar Nueva Empanada</h2>
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Nombre del Producto</label>
                        <input asp-for="Name" class="form-control form-control-pamelita" placeholder="Ej: Empanada de Queso" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Descripción</label>
                        <textarea asp-for="Description" class="form-control form-control-pamelita" rows="3" placeholder="Describe los ingredientes y sabor..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Precio (Bs.)</label>
                            <input asp-for="Price" class="form-control form-control-pamelita" type="number" step="0.5" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label fw-bold">Stock Disponible</label>
                            <input asp-for="Stock" class="form-control form-control-pamelita" type="number" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-bold">URL de la Imagen</label>
                        <input asp-for="ImageUrl" class="form-control form-control-pamelita" placeholder="https://..." />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Category" class="form-label fw-bold">Categoría</label>
                        <select asp-for="Category" class="form-select form-control-pamelita">
                            <option value="">-- Selecciona una categoría --</option>
                            @if (ViewBag.Categorias != null)
                            {
                                foreach (var cat in ViewBag.Categorias)
                                {
                                    <option value="@cat.Nombre">@cat.Nombre</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                        <small class="text-muted">Las categorías se gestionan desde <a asp-controller="Admin" asp-action="Categorias">Panel Admin → Categorías</a>.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-pamelita-secondary flex-grow-1 text-center">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-pamelita-primary flex-grow-1">
                            <i class="bi bi-check-circle me-1"></i> Guardar Producto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
