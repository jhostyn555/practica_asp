@model proyecto_asp.Models.Product

@{
    ViewData["Title"] = Model.Name + " - Empanadas Pamelita";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-pamelita-form">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6 text-center">
                        <div class="position-relative overflow-hidden rounded-4 shadow-sm bg-light">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=600" : Model.ImageUrl)" 
                                 class="img-fluid w-100 rounded-4" 
                                 alt="@Model.Name" 
                                 style="max-height: 350px; object-fit: cover;"
                                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1626700051175-6818013e1d4f?w=600';" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill mb-2">
                            @(string.IsNullOrEmpty(Model.Category) ? "Empanada Artesanal" : Model.Category)
                        </span>
                        <h1 class="fw-extrabold text-dark mb-2">@Model.Name</h1>
                        <p class="text-muted mb-4 lead">@Model.Description</p>
                        
                        <div class="p-3 bg-light rounded-3 mb-4 border border-warning">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-secondary fw-semibold">Precio por Unidad:</span>
                                <span class="fs-3 fw-bold text-danger">Bs. @Model.Price.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-secondary fw-semibold">Disponibilidad en Local:</span>
                                <span class="stock-indicator m-0"><i class="bi bi-box-seam"></i> @Model.Stock unidades</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="@Url.Action("Index")" class="btn btn-pamelita-secondary flex-grow-1 text-center">
                                <i class="bi bi-arrow-left me-1"></i> Volver al Menú
                            </a>
                            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-pamelita-warning">
                                    <i class="bi bi-pencil me-1"></i> Editar
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
